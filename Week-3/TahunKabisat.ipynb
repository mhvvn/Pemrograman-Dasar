   "metadata": {},
   "outputs": [],
   "source": [
    "kabisat = (tahun % 4 == 0 and tahun % 100 != 0) or (tahun % 400 == 0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 49,
   "id": "1497f621",
   "metadata": {},
   "outputs": [],
   "source": [
    "selisih = tahun_sekarang - tahun        # pengurangan\n",
    "\n",
    "dekade = tahun // 10                    # pembagian bulat\n",
    "\n",
    "sisa_4 = tahun % 4                        # sisa bagi 4\n",
    "sisa_100 = tahun % 100                    # sisa bagi 100\n",
    "sisa_400 = tahun % 400                    # sisa bagi 400\n",
    "\n",
    "habis_4 = sisa_4 == 0                     # habis dibagi 4?\n",
    "tidak_habis_100 = sisa_100 != 0           # tidak habis dibagi 100?\n",
    "kondisi_a = habis_4 and tidak_habis_100   # kondisi (a)\n",
    "kondisi_b = sisa_400 == 0                 # kondisi (b)\n",
    "kabisat = kondisi_a or kondisi_b          # hasil akhir\n",
    "\n",
    "status = [\"Bukan Tahun Kabisat\", \"Tahun Kabisat\"][kabisat]\n"
   ]
